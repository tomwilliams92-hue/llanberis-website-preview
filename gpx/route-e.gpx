<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Llanberis Bike Hire" xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>Llanberis Bike Hire - Route E: Lôn Eifion: Caernarfon to Bryncir</name>
    <desc>A gentle, traffic-free ride on the old railway line from Caernarfon, with views of Yr Eifl and the Snowdon range. Finish at Penygroes, or carry on to Bryncir. Grade: Very easy. About 19.7 km with 146 m of climbing. Start: Caernarfon. Finish: Bryncir. Llanberis Bike Hire drops off and picks up. Route line drawn on OpenStreetMap data, © OpenStreetMap contributors (ODbL).</desc>
    <author><name>Llanberis Bike Hire</name></author>
    <link href="https://www.llanberisbikehire.co.uk"><text>Llanberis Bike Hire</text></link>
  </metadata>
