<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Llanberis Bike Hire" xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>Llanberis Bike Hire - Route A: Clegyr Road circular</name>
    <desc>A gentle loop along Llyn Padarn and back over Clegyr Road, with a long freewheel into Llanberis and views of Snowdon all the way. Grade: Easy. About 10.2 km with 156 m of climbing. Start and finish: Llanberis Bike Hire, in the yard behind 34 High Street. Route line drawn on OpenStreetMap data, © OpenStreetMap contributors (ODbL).</desc>
    <author><name>Llanberis Bike Hire</name></author>
    <link href="https://www.llanberisbikehire.co.uk"><text>Llanberis Bike Hire</text></link>
  </metadata>
